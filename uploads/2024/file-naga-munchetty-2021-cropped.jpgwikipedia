.content .noresize a > img { max-width: none !important; }

.content figure[typeof~="mw:File"], .content figure[typeof~="mw:File/Frameless"] { display: table; border-collapse: collapse; }

.content figure[typeof~="mw:File"].mw-halign-right, .content figure[typeof~="mw:File/Frameless"].mw-halign-right { margin: 0px 0px 0.6em 0.6em; clear: right; float: right; }

.content figure[typeof~="mw:File"].mw-halign-left, .content figure[typeof~="mw:File/Frameless"].mw-halign-left { margin: 0px 0.6em 0.6em 0px; clear: left; float: left; }

