.cdx-progress-bar { box-sizing: border-box; overflow-x: hidden; }

.cdx-progress-bar__bar { width: 33.33%; height: 100%; }

.cdx-progress-bar:not(.cdx-progress-bar--inline) { position: relative; z-index: 1; height: 1em; max-width: none; border: 1px solid rgb(162, 169, 177); border-radius: 9999px; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 2px; }

