.cdx-search-result-title__match { font-weight: 400; }

.cdx-menu-item { list-style: none; position: relative; padding: 8px 12px; line-height: 1.6; transition-property: background-color, color, border-color, box-shadow; transition-duration: 0.1s; }

.cdx-menu-item__content { display: flex; align-items: center; line-height: 1.42857; overflow-wrap: break-word; hyphens: auto; }

