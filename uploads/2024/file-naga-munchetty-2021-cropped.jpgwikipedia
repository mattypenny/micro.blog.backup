.cdx-search-input--has-end-button .cdx-search-input__input-wrapper { flex-grow: 1; margin: -1px; }

.cdx-search-input--has-end-button .cdx-search-input__input-wrapper .cdx-text-input { border-top-right-radius: 0px; border-bottom-right-radius: 0px; }

.cdx-search-input__end-button { flex-shrink: 0; margin: -1px -1px -1px 0px; border-top-left-radius: 0px; border-bottom-left-radius: 0px; }

.cdx-search-input__end-button:hover, .cdx-search-input__end-button:focus { z-index: 1; }

.cdx-search-input__input-wrapper { position: relative; }

.cdx-search-input .cdx-text-input__icon.cdx-text-input__start-icon { background-position: center center; background-repeat: no-repeat; background-size: max(1.25em, 20px); min-width: 20px; min-height: 20px; width: 1.25em; height: 1.25em; display: inline-block; vertical-align: text-bottom; background-image: url("data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"%23202122\"><path d=\"M12.2 13.6a7 7 0 111.4-1.4l5.4 5.4-1.4 1.4zM3 8a5 5 0 1010 0A5 5 0 003 8z\"/></svg>"); }

.cdx-typeahead-search__menu { border-top-left-radius: 0px; border-top-right-radius: 0px; }

.cdx-typeahead-search .cdx-menu-item { padding: 0px; }

.cdx-typeahead-search .cdx-menu-item__content { padding: 8px 12px; }

.cdx-typeahead-search__search-footer { box-sizing: border-box; min-height: 56px; }

.cdx-typeahead-search__search-footer:visited { color: rgb(32, 33, 34); }

.cdx-typeahead-search__search-footer:hover { text-decoration: none; cursor: pointer; }

.cdx-typeahead-search__search-footer__icon { color: rgb(84, 89, 93); }

.cdx-typeahead-search__search-footer__active .cdx-typeahead-search__search-footer__icon, .cdx-typeahead-search__search-footer__active .cdx-typeahead-search__search-footer__text { color: rgb(51, 102, 204); }

.cdx-typeahead-search .cdx-typeahead-search__menu-message--has-thumbnail { padding-left: 20px; }

.cdx-typeahead-search--expanded .cdx-typeahead-search__input .cdx-text-input { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }

.cdx-typeahead-search .cdx-text-input--has-start-icon .cdx-text-input__input { padding-left: 36px; }

.cdx-typeahead-search--show-thumbnail.cdx-typeahead-search--auto-expand-width:not(.cdx-typeahead-search--expanded) { margin-left: 24px; }

.cdx-typeahead-search--show-thumbnail:not(.cdx-typeahead-search--auto-expand-width), .cdx-typeahead-search--show-thumbnail.cdx-typeahead-search--auto-expand-width.cdx-typeahead-search--expanded { margin-left: 0px; }

.cdx-typeahead-search--show-thumbnail:not(.cdx-typeahead-search--auto-expand-width) .cdx-text-input__input, .cdx-typeahead-search--show-thumbnail.cdx-typeahead-search--auto-expand-width.cdx-typeahead-search--expanded .cdx-text-input__input { padding-left: 60px; }

.cdx-typeahead-search--show-thumbnail:not(.cdx-typeahead-search--auto-expand-width) .cdx-text-input__start-icon, .cdx-typeahead-search--show-thumbnail.cdx-typeahead-search--auto-expand-width.cdx-typeahead-search--expanded .cdx-text-input__start-icon { position: absolute; top: 50%; min-width: 20px; min-height: 20px; width: 1.25em; height: 1.25em; transition-property: color; transition-duration: 0.1s; left: 22px; transform: translateY(-50%); }

.cdx-typeahead-search--show-thumbnail .cdx-typeahead-search__search-footer__icon { flex-shrink: 0; min-width: 40px; width: 2.5em; }

.cdx-typeahead-search .cdx-menu-item:first-child .cdx-typeahead-search__search-footer { border-top: unset; }

@media screen and (max-width: 500px) {
  .licensetpl { display: block; box-sizing: border-box; overflow-wrap: break-word; }
  .licensetpl > * { display: block; width: 100%; box-sizing: border-box; padding: 0px 0.5em !important; }
  .licensetpl > * > tr { display: flex; flex: 1 1 0%; flex-flow: column; width: 100%; box-sizing: border-box; }
  .licensetpl > * > tr > td, .licensetpl > * > tr > th { flex: 1 1 0%; box-sizing: border-box; width: 100% !important; padding: 0px !important; margin: 0px 0px 0.5em !important; }
  .licensetpl > * > tr > td:empty, .licensetpl > * > tr > * > img { display: none; }
  .fileinfotpl-type-information { display: block; box-sizing: border-box; border: 1px solid rgb(162, 169, 177); overflow-wrap: break-word; padding: 0px !important; }
  .fileinfotpl-type-information > * { display: block; width: 100%; box-sizing: border-box; padding: 0px !important; }
  .fileinfotpl-type-information > * > tr { display: flex; flex: 1 1 0%; flex-flow: wrap; width: 100%; box-sizing: border-box; }
  .fileinfotpl-type-information > * > tr > td { flex: 1 1 0%; box-sizing: border-box; border-bottom: 1px solid rgb(162, 169, 177); text-align: left; width: 100% !important; padding: 5px !important; margin: 0px !important; }
  .fileinfotpl-type-information > * > tr > td:first-child { flex: 0 0 20vw; border-right: 1px solid rgb(162, 169, 177); }
}

table { box-sizing: border-box !important; }

.filehistory td:last-child { word-break: break-word; min-width: 10em; }

@media print {
  span.mw-filepage-other-resolutions, #filetoc { display: none; }
  .mw_metadata { background: rgb(255, 255, 255); margin: 1em 0px; border: 1pt solid rgb(170, 170, 170); border-collapse: collapse; font-size: 10pt; }
  .mw_metadata caption { padding: 5px; font-size: 10pt; }
  .mw_metadata th, .mw_metadata td { border: 1pt solid rgb(170, 170, 170); padding: 0.4em 0.6em; background: rgb(255, 255, 255) !important; color: rgb(0, 0, 0) !important; }
  .mw_metadata th { text-align: center; }
}

.mw-filepage-resolutioninfo { font-size: smaller; }

.mw-filepage-multipage { display: flex; flex-direction: column; }

