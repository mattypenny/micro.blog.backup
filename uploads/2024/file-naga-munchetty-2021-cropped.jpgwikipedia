}

body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif; line-height: 1.4; -webkit-tap-highlight-color: rgba(0, 0, 0, 0.2); overflow-y: scroll; }

.content { line-height: 1.65; overflow-wrap: break-word; }

.content .center { width: 100%; text-align: center; }

