  .lazy-image-placeholder { break-inside: avoid; }
}

.minerva__tab-container { white-space: nowrap; overflow-x: auto; }

.minerva__tab-container .minerva__tab { font-size: 0.85em; margin: 0px 10px 0px 0px; font-weight: bold; padding-bottom: 6px; display: inline-block; }

.minerva__tab-container .minerva__tab:last-child { margin-right: 0px; }

.minerva__tab-container .minerva__tab.selected { border-bottom: 2px solid rgb(84, 89, 93); }

.minerva__tab-container a.minerva__tab { color: rgb(84, 89, 93); }

.minerva__tab-container a.minerva__tab:visited, .minerva__tab-container a.minerva__tab:hover, .minerva__tab-container a.minerva__tab:active { text-decoration: none; }

.minerva__tab-container a.minerva__tab.new, .minerva__tab-container a.minerva__tab.new:visited, .minerva__tab-container a.minerva__tab.new:hover, .minerva__tab-container a.minerva__tab.new:active { color: rgb(221, 51, 51); }

.minerva__tab-container li.minerva__tab a { color: rgb(84, 89, 93); }

.minerva__tab-container li.minerva__tab a:visited, .minerva__tab-container li.minerva__tab a:hover, .minerva__tab-container li.minerva__tab a:active { text-decoration: none; }

.minerva__tab-container li.minerva__tab.new a, .minerva__tab-container li.minerva__tab.new a:visited, .minerva__tab-container li.minerva__tab.new a:hover, .minerva__tab-container li.minerva__tab.new a:active { color: rgb(221, 51, 51); }

.toggle-list__list--drop-down { background: rgb(255, 255, 255); position: absolute; overflow-y: auto; z-index: 2; box-shadow: rgba(0, 0, 0, 0.24) 0px 5px 17px 0px, rgb(162, 169, 177) 0px 0px 1px; visibility: hidden; opacity: 0; transform: translateY(-8px); -webkit-tap-highlight-color: transparent; }

.toggle-list__list--drop-down .toggle-list-item:hover { background: rgb(234, 236, 240); }

.minerva-animations-ready .toggle-list__list--drop-down { transition: opacity 100ms ease-in-out 0s, -webkit-tap-highlight-color 0s ease-in-out 0s, transform 100ms ease-in-out 0s, visibility 100ms ease-in-out 0s; }

.toggle-list__checkbox:checked ~ .toggle-list__list--drop-down { transform: translateY(0px); visibility: visible; opacity: 1; }

.minerva-user-menu-list { top: 100%; right: -0.75em; min-width: 200px; max-width: 21.875em; border-radius: 2px; }

.minerva--history-page-action-enabled .page-actions-menu__list-item { flex-basis: auto; }

.minerva--history-page-action-enabled .page-actions-menu__list-item:first-child { flex-grow: 0; }

#page-actions-overflow-toggle .minerva-icon { transform: rotate(90deg); }

.page-actions-overflow-list { top: 100%; right: -0.75em; border-radius: 2px; }

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important; }
}

div, span, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, ins, em, img, small, strike, strong, sub, sup, tt, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, input, button, select, audio, video, figure, picture { margin: 0px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-size: 100%; vertical-align: baseline; background: none; }

table, caption, tbody, tfoot, thead, tr, th, td { font-size: 100%; }

caption { font-weight: bold; }

button { border: 0px; background-color: transparent; cursor: pointer; }

input { line-height: normal; }

ul { list-style: none; }

table { border-collapse: collapse; }

.minerva-icon--modified-history { min-width: 20px; min-height: 20px; width: 1.25em; height: 1.25em; display: inline-block; vertical-align: text-bottom; }

@supports (mask-image:none) or (-webkit-mask-image:none) {
  .minerva-icon--modified-history { mask-size: max(1.25em, 20px); mask-repeat: no-repeat; mask-position: center center; }
}

@supports (mask-image:none) or (-webkit-mask-image:none) {
  .minerva-icon--modified-history { background-image: none; mask-image: url("data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"%23000000\"><path d=\"M9 6v5h.06l2.48 2.47 1.41-1.41L11 10.11V6z\"/><path d=\"M10 1a9 9 0 00-7.85 13.35L.5 16H6v-5.5l-2.38 2.38A7 7 0 1110 17v2a9 9 0 000-18z\"/></svg>"); transition-property: background-color; transition-duration: 100ms; }
}

.minerva-icon--expand { min-width: 20px; min-height: 20px; width: 1.25em; height: 1.25em; display: inline-block; vertical-align: text-bottom; }

@supports (mask-image:none) or (-webkit-mask-image:none) {
  .minerva-icon--expand { mask-size: max(1.25em, 20px); mask-repeat: no-repeat; mask-position: center center; }
