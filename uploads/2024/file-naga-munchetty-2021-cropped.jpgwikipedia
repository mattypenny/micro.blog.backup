.pre-content h1, .content .mw-heading1, .content h1, .content .mw-heading2, .content h2, .mw-heading3, .mw-heading4, .mw-heading5, .mw-heading6, h3, h4, h5, h6 { line-height: 1.375; overflow-wrap: break-word; word-break: break-word; }

.content .mw-heading2, .content .mw-heading3, .content .mw-heading4, .content .mw-heading5, .content .mw-heading6, .content h2, .content h3, .content h4, .content h5, .content h6 { padding: 0.5em 0px; }

