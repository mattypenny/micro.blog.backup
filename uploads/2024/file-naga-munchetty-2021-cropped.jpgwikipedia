@media (max-width: calc(639px)) {
  .mw-filepage-multipage-navigation { flex-wrap: wrap; justify-content: space-between; }
  .mw-filepage-multipage-navigation.mw-filepage-multipage-navigation figure, .mw-filepage-multipage-navigation.mw-filepage-multipage-navigation .thumb { display: none; }
  .mw-filepage-multipage-navigation > * { flex: 1 1 auto; }
  .mw-filepage-multipage-navigation > form { text-align: center; }
  .mw-filepage-multipage-navigation > :last-child { text-align: end; }
}

@media (min-width: 640px) {
